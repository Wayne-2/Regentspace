rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── All data lives under apps/regentspace-builder/ ───
    match /apps/{platformAppId} {

      // ─── Shared platform config ───
      // apps/regentspace-builder/config/* — readable by any authenticated user
      match /config/{configId} {
        allow read: if request.auth != null;
        allow write: if false; // set during build, read-only at runtime
      }

      // ─── Per-app data ───
      // apps/regentspace-builder/apps/{appId}/* — only the creator can access
      match /apps/{appId} {
        // App document — only the creator can read/write
        allow read, update, delete: if request.auth != null
          && resource.data.createdBy == request.auth.uid;
        allow create: if request.auth != null;

        // User profiles for THIS generated app
        match /users/{uid} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow create, update: if request.auth != null && request.auth.uid == uid;

          // Monnify virtual accounts per user
          match /monnifyAccounts/{ref} {
            allow read, write: if request.auth != null && request.auth.uid == uid;
          }

          // Notifications per user
          match /notifications/{notifId} {
            allow read, write: if request.auth != null && request.auth.uid == uid;
          }
        }

        // Monnify reserved accounts — user can read their own, create their own
        match /monnify_reserved_accounts/{ref} {
          allow read: if request.auth != null
            && resource.data.uid == request.auth.uid;
          allow create: if request.auth != null
            && request.resource.data.uid == request.auth.uid;
          allow update: if request.auth != null
            && resource.data.uid == request.auth.uid;
        }

        // Monnify transactions (webhook writes via Admin SDK)
        match /monnify_transactions/{id} {
          allow read: if request.auth != null
            && resource.data.uid == request.auth.uid;
          allow write: if false; // webhook only
        }

        // VTPass transactions — user can read their own, app creator can read all
        match /vtpass_transactions/{id} {
          allow read: if request.auth != null && (
            resource.data.uid == request.auth.uid ||
            resource.data.createdBy == request.auth.uid
          );
          allow create: if request.auth != null
            && request.resource.data.uid == request.auth.uid;
          allow update, delete: if false; // webhook/admin only
        }
      }
    }
  }
}
