rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles — same shape for email/password and Google
    // Write path: UserRepository.saveEmailUser / saveGoogleUser -> users/{uid}
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      // Subcollection for Monnify virtual accounts (client mirrors Monnify response)
      // Path: users/{uid}/monnifyAccounts/{accountReference} - MonnifyService.createReservedAccount:217
      match /monnifyAccounts/{ref} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // Notifications per-user — persisted by AppNotifications._show + PushNotificationService
      // Dashboard badge: watchUnreadCount, NotificationPage: watchForUser
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Global mirror for webhook lookups — written by client in direct mode,
    // or by webhook Admin SDK (which bypasses rules). Must allow client create when useDirect=true.
    // Previous `allow write: if false` blocked direct-mode batch.commit at MonnifyService:219 -> permission-denied.
    match /monnify_reserved_accounts/{ref} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid);
    }

    match /monnify_transactions/{id} {
      allow read: if request.auth != null;
      allow write: if false; // webhook only via Admin SDK
    }

    // Monnify credentials — read requires auth (secret). Cold-start load before login fails
    // with permission-denied (log 13:00:27.991), retried after login via MonnifyConfig.ensureConfigured().
    // Do NOT set allow read: if true in prod — that would leak apiKey/secretKey publicly.
    match /config/monnify {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
